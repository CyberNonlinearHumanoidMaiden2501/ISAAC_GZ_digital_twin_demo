<div id="EventsControl">
    <ul class="calendar mini" aria-live="polite"></ul>
</div>

<script>
    var url='/api/events/events/calendar/0/2/2?HideDivisions=38';

    function createLi(it) {
        var tpl = $('<li><div class="calendar-date"><span class="calendar-day"></span> <span class="calendar-month" style="display:block;"></span></div><div class="calendar-event"><span class="calendar-event-title"></span><a class="calendar-event-ical" type="text/calendar" download="event.ics"></a></div></li>'),
            d = it.DateText.split(' ');
        tpl.find('.calendar-day').text(d[0]);
        tpl.find('.calendar-month').text(d[1]);
        tpl.find('.calendar-event-title').text(it.EventName);
        tpl.find('.calendar-event-ical').attr('href', '/api/events/events/calendarItem/2/' + it.EventId);
        return tpl;
    }
    head.ready(function () {
        $.getJSON(url).done(function (data) {
            var cal = $('ul.calendar.mini');
            cal.find('li').remove();
            $.each(data, function (k, it) { createLi(it).appendTo(cal); });
        });
    });
</script>

