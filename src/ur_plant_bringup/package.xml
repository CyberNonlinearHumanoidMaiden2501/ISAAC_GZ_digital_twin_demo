<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_plant_bringup</name>
  <version>0.0.0</version>
  <description>Launch files and ROS configuration for the UR plant simulation</description>
  <maintainer email="yutsin2501@gmail.com">Qingyu Geng</maintainer>
  <license>Apache 2.0</license>
  <author>Qingyu Geng</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ur_controllers</exec_depend>
  <exec_depend>xacro</exec_depend>

  <exec_depend>ur_plant_description</exec_depend>
  <exec_depend>ur_plant_sensors</exec_depend>
  <exec_depend>ur_plant_world</exec_depend>

  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
