<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_plant_world</name>
  <version>0.0.0</version>
  <description>Gazebo Harmonic worlds and gz-sim system plugins for the UR plant simulation</description>
  <maintainer email="yutsin2501@gmail.com">Qingyu Geng</maintainer>
  <license>Apache 2.0</license>
  <author>Qingyu Geng</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Gazebo library deps are intentionally not listed here: they are resolved via
       CMake find_package against the vendor prefixes (template pattern). -->
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>ur_plant_sensors</exec_depend>

  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
